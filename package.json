{
  "name": "telegram-poker-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm run start:dev --workspace=server",
    "build:shared": "npm run build --workspace=@telegram-poker/shared",
    "build": "npm run build:shared && npm run build --workspace=web && npm run build --workspace=server"
  }
}
