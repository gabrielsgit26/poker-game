# Copy to apps/server/.env (or set paths below from repo root)

# API (NestJS)
PORT=3031

# MongoDB (local default; change host/port/db as needed)
MONGODB_URI=mongodb://127.0.0.1:27017/poker

# Redis (local default; change as needed)
REDIS_URL=redis://127.0.0.1:6379

# Browser origins allowed to call the API + Socket.IO (comma-separated, no trailing slash).
# Must include your deployed frontend, e.g. the Vercel URL. Defaults to localhost:3000 + web.telegram.org.
CORS_ORIGIN=https://poker-game-web.vercel.app,http://localhost:3000,https://web.telegram.org

# Provably-fair deal (commit/reveal). Optional per-deployment salt used only as extra
# entropy when generating each hand's private seed. It never enters the deck
# derivation, so players verify a finished hand from the revealed seeds alone and
# rotating the salt never invalidates past hands. Leave unset to deal without a salt.
# POKER_FAIRNESS_SALT=change-me-to-a-long-random-string


# Telegram Mini App — required for POST /auth/telegram (HMAC validation of initData)
# TELEGRAM_BOT_TOKEN=123456:ABC...

# Optional: comma-separated poker user ids allowed to call GET /admin/overview and POST /admin/clubs/.../chip-grant
PLATFORM_ADMIN_USER_IDS=local-player

# Optional: force-enable POST /auth/dev-login in production (default: off in prod)
AUTH_ALLOW_DEV_LOGIN=true

# Next.js (optional; for API base URL)
# Option A — direct API (cookies will NOT attach cross-port; use X-Dev-User-Id only):
NEXT_PUBLIC_API_URL=https://supersagacious-impossibly-hilda.ngrok-free.dev
#
# Option B — first-party /api proxy (recommended for Phase 2 HTTP-only session cookies):
# In apps/web/.env.local set:
#   NEXT_PUBLIC_API_URL=/api
#   API_PROXY_TARGET=http://localhost:3001
# (API_PROXY_TARGET is read by Next at dev/build time for rewrites in next.config.ts)
