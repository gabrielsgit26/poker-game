# Copy to apps/server/.env (or set paths below from repo root)

# API (NestJS)
PORT=3001

# MongoDB (local default; change host/port/db as needed)
MONGODB_URI=mongodb://127.0.0.1:27017/poker

# Redis (local default; change as needed)
REDIS_URL=redis://127.0.0.1:6379

# Next.js (optional; Phase 2+ for API base URL)
# NEXT_PUBLIC_API_URL=http://localhost:3001
